# Settings for Eats.
#
# For your Mac: copy this file to .env (cp .env.example .env). The values
# below are fine for local development.
#
# For the live app: set these on the hosting service instead, and choose
# NEW passcodes. Never commit a real .env file — .gitignore keeps it out of git.

# Passcode Lily and Andrei share. Unlocks Lily, Andrei and Viewer.
OWNER_PASSCODE=owner-dev-only

# Passcode for read-only guests. Only unlocks Viewer.
VIEWER_PASSCODE=viewer-dev-only

# Where the database file lives. The folder is created if it doesn't exist.
DATABASE_PATH=data/eats.db

# Only needed in production, set to the app's public web address, e.g.
# ORIGIN=https://eats.example.com
