{
	"name": "eats",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build --logLevel warn",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test:unit": "vitest",
		"test": "npm run test:unit -- --run",
		"lint": "prettier --check .",
		"format": "prettier --write .",
		"db:reset": "node --env-file-if-exists=.env scripts/db-reset.ts",
		"db:migrate": "node --env-file-if-exists=.env scripts/db-migrate.ts",
		"start": "node --env-file-if-exists=.env build",
		"deploy": "bash deploy/deploy.sh",
		"db:backup": "node --env-file-if-exists=.env scripts/db-backup.ts",
		"recipes:load": "node --env-file-if-exists=.env scripts/load-saved-recipes.ts"
	},
	"devDependencies": {
		"@sveltejs/adapter-node": "^6.0.0",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@types/node": "^24",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.1.0",
		"svelte": "^5.57.1",
		"svelte-check": "^4.6.0",
		"typescript": "^6.0.3",
		"vite": "^8.3.0",
		"vitest": "^4.1.8"
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	},
	"engines": {
		"node": ">=24"
	},
	"dependencies": {
		"@anthropic-ai/sdk": "^0.135.0",
		"zod": "^4.6.7"
	}
}
